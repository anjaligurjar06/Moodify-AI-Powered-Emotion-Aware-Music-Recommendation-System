# Copy this file to .env and fill in real values before running in production.

APP_NAME=Moodify API
ENV=development

# Generate a strong random string for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-this-secret-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite:///./moodify.db

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave blank to run on the built-in curated track catalog.
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
